{
  "name": "@smoochy/claude-router",
  "version": "0.4.0-smoo.8",
  "description": "Claude API cost router for Claude Code: routes each call to Haiku, Sonnet, Opus or Fable, with a route/observe/off switch, a CI-generated model and price list, and a security-gated release per version",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "claude-router": "dist/proxy/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/proxy/cli.js', 0o755)\"",
    "test": "npm run build && node scripts/run-tests.mjs",
    "dev": "tsc --watch",
    "pricing:refresh": "node scripts/refresh-pricing-snapshot.mjs",
    "proxy": "node dist/proxy/cli.js",
    "prepublishOnly": "npm test",
    "test:coverage": "npm run build && COVERAGE=1 node scripts/run-tests.mjs"
  },
  "keywords": [
    "claude",
    "anthropic",
    "llm",
    "router",
    "model-router",
    "ai",
    "cost-optimization",
    "haiku",
    "sonnet",
    "opus",
    "proxy",
    "claude-code",
    "anthropic-proxy",
    "llm-gateway",
    "orchestration",
    "subagents",
    "claude-5",
    "cost-tracking",
    "llm-proxy",
    "model-routing"
  ],
  "author": "smoochy",
  "contributors": [
    {
      "name": "Serhii Leniv",
      "url": "https://github.com/Serhii-Leniv/claude-router"
    }
  ],
  "funding": [
    "https://ko-fi.com/smoochy",
    "https://buymeacoffee.com/smoochy84"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoochy/Claude-router.git"
  },
  "homepage": "https://github.com/smoochy/Claude-router",
  "bugs": {
    "url": "https://github.com/smoochy/Claude-router/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.0.1",
    "hono": "^4.13.13"
  },
  "optionalDependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.29.0",
    "@anthropic-ai/vertex-sdk": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "assets/claude-router.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "plugin",
    ".claude-plugin"
  ]
}
